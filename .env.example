# LM Studio (OpenAI-compatible local server)
# Start its local server before launching FastAPI.
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LM_STUDIO_MODEL="google/gemma-4-e4b"
LM_STUDIO_TIMEOUT_SECONDS=180
ASSISTANT_BEHAVIOR_CONFIG=behavior.json
ASSISTANT_TIMEZONE=America/Mexico_City

# Selenium / Buscalibre settings
HEADLESS_MODE=true
WEBDRIVER_PATH=""
