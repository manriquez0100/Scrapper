# "mock" muestra el catálogo de ejemplo. Cambie a "firebase" cuando Firestore esté disponible.
VITE_CATALOG_SOURCE=mock

# Requerido sólo si VITE_CATALOG_SOURCE=firebase.
VITE_FIREBASE_PROJECT_ID=tu-proyecto-firebase
VITE_FIRESTORE_COLLECTION=books

# Enlace de pago seguro creado desde la cuenta comercial de PayPal.
# No guarde secretos de PayPal en este archivo ni en el frontend.
VITE_PAYPAL_PAYMENT_URL=https://www.paypal.com/
